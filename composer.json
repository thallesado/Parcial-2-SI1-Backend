{
  "name": "universidad/admision-backend",
  "type": "project",
  "description": "API Laravel para admision e inscripcion universitaria.",
  "require": {
    "php": "^8.3",
    "barryvdh/laravel-dompdf": "^3.1",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^2.10",
    "stripe/stripe-php": "^20.2"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.18",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "serve": "php artisan serve --host=127.0.0.1 --port=8000"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
